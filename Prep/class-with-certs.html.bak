    // Application State
    let currentLessonIndex = 0;
    let selectedLineIndex = null;

    // DOM Elements
    const lessonSelectorContainer = document.getElementById('lesson-selector-container');
    const moduleCounter = document.getElementById('module-counter');
    const badgeCourse = document.getElementById('badge-course');
    const badgeCert = document.getElementById('badge-cert');
    const certText = document.getElementById('cert-text');
    const lessonTitle = document.getElementById('lesson-title');
    const lessonDescription = document.getElementById('lesson-description');
    const fileNameText = document.getElementById('file-name-text');
    const editorTableBody = document.getElementById('editor-table-body');
    const educatorContent = document.getElementById('educator-content');
    const activeLineBadge = document.getElementById('active-line-badge');
    const takeawaysList = document.getElementById('takeaways-list');
    const progressBarFill = document.getElementById('progress-bar-fill');
    const progressText = document.getElementById('progress-text');
    const editorLanguageTag = document.getElementById('editor-language-tag');

    // Initialize App
    function initApp() {
      renderCurriculumList();
      loadLesson(0);
    }

    // Render Curriculum Switcher List
    function renderCurriculumList() {
      lessonSelectorContainer.innerHTML = '';
      
      LESSONS.forEach((lesson, index) => {
        const isActive = index === currentLessonIndex;
        const card = document.createElement('div');
        card.className = `p-3.5 rounded-xl cursor-pointer transition-all duration-200 border flex flex-col gap-1.5 ${
          isActive 
            ? 'bg-glass-active border-emerald-500/40 shadow-lg ring-1 ring-emerald-500/20' 
            : 'bg-white/5 hover:bg-white/10 border-white/5'
        }`;
        card.onclick = () => loadLesson(index);

        card.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              ${lesson.courseCode}
            </span>
            <span class="text-[10px] font-mono text-gray-400 flex items-center gap-1">
              <i data-lucide="shield" class="w-3 h-3 text-orange-400"></i> ${lesson.certTarget.split('/')[0]}
            </span>
          </div>
          <h3 class="text-xs font-semibold text-gray-200 line-clamp-1">${lesson.title}</h3>
        `;
        lessonSelectorContainer.appendChild(card);
      });

      // Refresh icons
      if (window.lucide) lucide.createIcons();
    }

    // Load Chosen Lesson
    function loadLesson(index) {
      currentLessonIndex = index;
      selectedLineIndex = null; // Reset line selection
      const lesson = LESSONS[index];

      // Update Top Curriculum Meta
      moduleCounter.textContent = `Lesson ${index + 1} of ${LESSONS.length}`;
      badgeCourse.textContent = lesson.courseCode;
      certText.textContent = lesson.certTarget;
      lessonTitle.textContent = lesson.title;
      lessonDescription.textContent = lesson.description;
      fileNameText.textContent = lesson.fileName;
      editorLanguageTag.textContent = `Language: ${lesson.language.toUpperCase()}`;

      // Update Progress Bar
      const pct = Math.round(((index + 1) / LESSONS.length) * 100);
      progressBarFill.style.width = `${pct}%`;
      progressText.textContent = `${pct}% Complete`;

      // Render Key Takeaways
      takeawaysList.innerHTML = lesson.takeaways
        .map(t => `<li class="flex items-start gap-2"><i data-lucide="chevron-right" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5"></i> <span>${t}</span></li>`)
        .join('');

      // Render Code Table & Educator Default
      renderCodeEditor();
      renderEducatorPanel();
      renderCurriculumList();

      if (window.lucide) lucide.createIcons();
    }

    // Render Code Table Rows
    function renderCodeEditor() {
      const lesson = LESSONS[currentLessonIndex];
      editorTableBody.innerHTML = '';

      lesson.lines.forEach((lineObj, idx) => {
        const isSelected = selectedLineIndex === idx;
        const row = document.createElement('tr');
        row.className = `group cursor-pointer transition-colors duration-150 border-b border-white/[0.02] ${
          isSelected 
            ? 'bg-emerald-500/15 border-l-4 border-l-emerald-400' 
            : 'hover:bg-white/[0.04]'
        }`;
        row.onclick = () => selectLine(idx);

        // Escape raw HTML characters before passing to Prism
        const escapedCode = escapeHtml(lineObj.code);
        const highlightedCode = Prism.highlight(
          escapedCode, 
          Prism.languages[lesson.language] || Prism.languages.python, 
          lesson.language
        );

        row.innerHTML = `
          <!-- Gutter Column -->
          <td class="w-12 select-none text-right pr-3 py-1 font-mono text-xs text-[#4b5563] bg-[#080b11] border-r border-white/5 group-hover:text-gray-300">
            ${idx + 1}
          </td>
          <!-- Code Content Column -->
          <td class="pl-4 pr-4 py-1 font-mono text-xs whitespace-pre">
            <code class="language-${lesson.language}">${highlightedCode || '&nbsp;'}</code>
          </td>
        `;
        editorTableBody.appendChild(row);
      });
    }

    // Select Specific Code Line
    function selectLine(idx) {
      if (selectedLineIndex === idx) {
        selectedLineIndex = null; // Toggle off if clicked twice
      } else {
        selectedLineIndex = idx;
      }
      renderCodeEditor();
      renderEducatorPanel();
    }

    // Render Educator Explanation Panel
    function renderEducatorPanel() {
      const lesson = LESSONS[currentLessonIndex];

      if (selectedLineIndex === null) {
        activeLineBadge.textContent = "Overview Mode";
        activeLineBadge.className = "px-2 py-0.5 text-[10px] font-mono rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20";

        educatorContent.innerHTML = `
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 space-y-2">
            <div class="flex items-center gap-2 text-emerald-400 font-semibold text-xs">
              <i data-lucide="info" class="w-4 h-4"></i> Lesson Navigation Tip
            </div>
            <p class="text-xs text-gray-300 leading-relaxed">
              ${lesson.overviewNote}
            </p>
          </div>
          <div class="space-y-2 pt-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400">Target Mapping Summary</h4>
            <div class="p-3 rounded-lg bg-[#080b11] border border-white/5 space-y-1.5 font-mono text-xs">
              <div class="text-emerald-400 flex justify-between">
                <span>Course:</span> <span class="text-white">${lesson.courseCode}</span>
              </div>
              <div class="text-orange-400 flex justify-between">
                <span>Cert Objective:</span> <span class="text-white">${lesson.certTarget}</span>
              </div>
            </div>
          </div>
        `;
      } else {
        const lineObj = lesson.lines[selectedLineIndex];
        activeLineBadge.textContent = `Line ${selectedLineIndex + 1}`;
        activeLineBadge.className = "px-2 py-0.5 text-[10px] font-mono rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30";

        educatorContent.innerHTML = `
          <div class="p-3 rounded-lg bg-[#080b11] border border-emerald-500/30 font-mono text-xs text-emerald-300 overflow-x-auto">
            <code>${escapeHtml(lineObj.code) || '// Empty line'}</code>
          </div>

          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 space-y-2">
            <div class="flex items-center gap-2 text-cyan-400 font-semibold text-xs">
              <i data-lucide="microscope" class="w-4 h-4"></i> Line Breakdown & Exam Relevance
            </div>
            <p class="text-xs text-gray-200 leading-relaxed">
              ${lineObj.note}
            </p>
          </div>

          <div class="p-3 rounded-xl bg-orange-500/10 border border-orange-500/20 text-xs text-orange-200 flex items-start gap-2">
            <i data-lucide="check-square" class="w-4 h-4 text-orange-400 shrink-0 mt-0.5"></i>
            <span>This concept links directly to practical lab questions in <strong>${lesson.certTarget.split('/')[0]}</strong>.</span>
          </div>
        `;
      }

      if (window.lucide) lucide.createIcons();
    }

    // Helper Utility: Escape HTML
    function escapeHtml(str) {
      if (!str) return '';
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    // Copy Current Code to Clipboard
    function copyCodeToClipboard() {
      const lesson = LESSONS[currentLessonIndex];
      const fullCode = lesson.lines.map(l => l.code).join('\n');
      
      navigator.clipboard.writeText(fullCode).then(() => {
        const copyBtn = document.getElementById('copy-btn');
        copyBtn.innerHTML = `<i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400"></i> Copied!`;
        if (window.lucide) lucide.createIcons();

        setTimeout(() => {
          copyBtn.innerHTML = `<i data-lucide="copy" class="w-3.5 h-3.5"></i> Copy Code`;
          if (window.lucide) lucide.createIcons();
        }, 2000);
      });
    }

    // Load App on Window Ready
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
